{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EngagementEvent",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EVT-[0-9]{8}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "customer_id": {
      "type": "string",
      "pattern": "^CUST-[0-9]{5}$"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^CAMP-[0-9]{5}$"
    },
    "event_type": {
      "type": "string",
      "enum": ["impression", "click", "conversion"]
    },
    "industry": {
      "type": "string",
      "enum": ["bfsi", "insurance", "rcg", "travel", "healthcare", "manufacturing"]
    },
    "attribution_weight": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "cost": {
      "type": "number",
      "minimum": 0.0
    },
    "revenue": {
      "type": "number",
      "minimum": 0.0
    }
  },
  "required": ["event_id", "timestamp", "customer_id", "campaign_id", "event_type", "industry", "attribution_weight", "cost", "revenue"]
}
