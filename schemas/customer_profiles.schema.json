{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CustomerProfile",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "pattern": "^CUST-[0-9]{5}$"
    },
    "industry": {
      "type": "string",
      "enum": ["bfsi", "insurance", "rcg", "travel", "healthcare", "manufacturing"]
    },
    "acquisition_channel": {
      "type": "string",
      "enum": ["Facebook", "Instagram", "LinkedIn", "Organic_Search", "Referral", "Email"]
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "age": {
      "type": ["integer", "null"],
      "minimum": 18,
      "maximum": 100
    },
    "gender": {
      "type": ["string", "null"],
      "enum": ["Male", "Female", "Non-binary", "Other", null]
    },
    "segment": {
      "type": "string",
      "enum": ["Value", "Mid-Market", "Enterprise", "Consumer"]
    },
    "signup_date": {
      "type": "string",
      "format": "date"
    },
    "total_spend_to_date": {
      "type": "number",
      "minimum": 0
    },
    "last_purchase_date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "days_since_last_purchase": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Days between last_purchase_date and the reference date (2026-08-20). Null if customer has never purchased."
    },
    "purchase_frequency": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of conversion events attributed to this customer in the generated dataset."
    },
    "churn_risk_tier": {
      "type": "string",
      "enum": ["Low", "Medium", "High"],
      "description": "Ground-truth churn risk tier computed from RFM signals and industry-specific churn windows."
    },
    "is_churned": {
      "type": "boolean",
      "description": "True when churn_risk_tier is High. Ground-truth label for Agent 6 (Predictive Churn) model training."
    },
    "top_drivers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Key factors explaining the customer's churn risk score (e.g. inactivity, low frequency, segment vulnerability)."
    }
  },
  "required": [
    "customer_id", "industry", "acquisition_channel", "name", "email",
    "age", "gender", "segment", "signup_date", "total_spend_to_date",
    "last_purchase_date",
    "days_since_last_purchase", "purchase_frequency", "churn_risk_tier", "is_churned",
    "top_drivers"
  ]
}
